//@version=6
indicator(
    title="Smart AI Crypto Pro v4 Ultimate",
    shorttitle="SAICP v4",
    overlay=true,
    max_labels_count=500,
    max_lines_count=500,
    max_boxes_count=500)

//====================================================
// MODULE 01 - CORE ENGINE
// VERSION : v4.0-alpha
//====================================================

//==============================
// INPUT GROUPS
//==============================

string grpTrend   = "Trend Engine"
string grpAI      = "AI Engine"
string grpRisk    = "Risk Management"
string grpDisplay = "Display"

//==============================
// TREND INPUTS
//==============================

fastEMA  = input.int(20, "Fast EMA", minval=1, group=grpTrend)
slowEMA  = input.int(50, "Slow EMA", minval=1, group=grpTrend)
trendEMA = input.int(200, "Trend EMA", minval=1, group=grpTrend)

//==============================
// AI INPUTS
//==============================

minimumAIScore = input.int(70, "Minimum AI Score", minval=50, maxval=100, group=grpAI)

//==============================
// RISK INPUTS
//==============================

atrLength     = input.int(14, "ATR Length", group=grpRisk)
atrMultiplier = input.float(1.5, "ATR Multiplier", step=0.1, group=grpRisk)

//==============================
// DISPLAY
//==============================

showSignals   = input.bool(true, "Show Buy / Sell", group=grpDisplay)
showDashboard = input.bool(true, "Show Dashboard", group=grpDisplay)
showTP        = input.bool(true, "Show TP Levels", group=grpDisplay)

//==============================
// COLOR ENGINE
//==============================

buyColor   = color.lime
sellColor  = color.orange
tpColor    = color.lime
slColor    = color.red
entryColor = color.white

//==============================
// CORE CALCULATIONS
//==============================

emaFast  = ta.ema(close, fastEMA)
emaSlow  = ta.ema(close, slowEMA)
emaTrend = ta.ema(close, trendEMA)

atr = ta.atr(atrLength)

// Hidden EMA Plots
plot(emaFast, display=display.none)
plot(emaSlow, display=display.none)
plot(emaTrend, display=display.none)

//==============================
// GLOBAL VARIABLES
//==============================

var bool tradeRunning = false
var int tradeSide = 0

var float entryPrice = na
var float stopLoss = na

var float tp1 = na
var float tp2 = na
var float tp3 = na
var float tp4 = na
var float tp5 = na
var float tp6 = na
var float tp7 = na
var float tp8 = na
//====================================================
// MODULE 02 - TREND ENGINE
//====================================================

// Trend Detection
bullTrend = emaFast > emaSlow and close > emaTrend
bearTrend = emaFast < emaSlow and close < emaTrend

// EMA Cross
bullCross = ta.crossover(emaFast, emaSlow)
bearCross = ta.crossunder(emaFast, emaSlow)

// Trend Strength
emaDistance = math.abs(emaFast - emaSlow)

strongBullTrend = bullTrend and emaDistance > atr * 0.30
strongBearTrend = bearTrend and emaDistance > atr * 0.30

// Market Direction
string marketTrend = "SIDEWAYS"

if strongBullTrend
    marketTrend := "BULLISH"
else if strongBearTrend
    marketTrend := "BEARISH"

// Trend Score
int trendScore = 0

if strongBullTrend
    trendScore := 100
else if strongBearTrend
    trendScore := -100

// Hidden Values
plot(trendScore, title="Trend Score", display=display.none)
//====================================================
// MODULE 03 - MOMENTUM ENGINE
//====================================================

//-------------------------
// RSI
//-------------------------

rsiLength = input.int(14, "RSI Length", group=grpAI)
rsiValue = ta.rsi(close, rsiLength)

bullRSI = rsiValue > 55
bearRSI = rsiValue < 45

//-------------------------
// MACD
//-------------------------

macdFast = input.int(12, "MACD Fast", group=grpAI)
macdSlow = input.int(26, "MACD Slow", group=grpAI)
macdSignal = input.int(9, "MACD Signal", group=grpAI)

macdLine = ta.ema(close, macdFast) - ta.ema(close, macdSlow)
signalLine = ta.ema(macdLine, macdSignal)
histogram = macdLine - signalLine

bullMACD = macdLine > signalLine
bearMACD = macdLine < signalLine

//-------------------------
// Volume
//-------------------------

volMA = ta.sma(volume, 20)

highVolume = volume > volMA

//-------------------------
// MOMENTUM SCORE
//-------------------------

int bullMomentumScore = 0
int bearMomentumScore = 0

if bullRSI
    bullMomentumScore += 25

if bullMACD
    bullMomentumScore += 25

if highVolume
    bullMomentumScore += 25

if strongBullTrend
    bullMomentumScore += 25

if bearRSI
    bearMomentumScore += 25

if bearMACD
    bearMomentumScore += 25

if highVolume
    bearMomentumScore += 25

if strongBearTrend
    bearMomentumScore += 25

//-------------------------
// MOMENTUM FILTER
//-------------------------

bullMomentum = bullMomentumScore >= minimumAIScore
bearMomentum = bearMomentumScore >= minimumAIScore

// Hidden plots
plot(rsiValue, title="RSI", display=display.none)
plot(macdLine, title="MACD", display=display.none)
plot(signalLine, title="Signal", display=display.none)
plot(histogram, title="Histogram", display=display.none)
//====================================================
// MODULE 04 - AI SIGNAL ENGINE
//====================================================

//-------------------------
// AI SCORE
//-------------------------

int aiBuyScore = 0
int aiSellScore = 0

// Trend
if strongBullTrend
    aiBuyScore += 30

if strongBearTrend
    aiSellScore += 30

// Momentum
if bullMomentum
    aiBuyScore += 30

if bearMomentum
    aiSellScore += 30

// EMA Cross
if bullCross
    aiBuyScore += 20

if bearCross
    aiSellScore += 20

// Candle Confirmation
bullCandle = close > open
bearCandle = close < open

if bullCandle
    aiBuyScore += 20

if bearCandle
    aiSellScore += 20

//-------------------------
// FINAL AI SIGNAL
//-------------------------

buySignal = aiBuyScore >= minimumAIScore
sellSignal = aiSellScore >= minimumAIScore

//-------------------------
// AI RATING
//-------------------------

string aiRating = "NEUTRAL"

if buySignal
    aiRating := "BUY"

if sellSignal
    aiRating := "SELL"

// Hidden plots
plot(aiBuyScore, title="AI Buy Score", display=display.none)
plot(aiSellScore, title="AI Sell Score", display=display.none)
//====================================================
// MODULE 05 - SMART MONEY CONCEPTS (BASE)
//====================================================

//-------------------------
// Swing Detection
//-------------------------

swingLength = input.int(5, "Swing Length", minval=2, group="Smart Money")

swingHigh = ta.pivothigh(high, swingLength, swingLength)
swingLow  = ta.pivotlow(low, swingLength, swingLength)

//-------------------------
// Break Of Structure
//-------------------------

var float lastSwingHigh = na
var float lastSwingLow = na

if not na(swingHigh)
    lastSwingHigh := swingHigh

if not na(swingLow)
    lastSwingLow := swingLow

bullBOS = not na(lastSwingHigh) and close > lastSwingHigh
bearBOS = not na(lastSwingLow) and close < lastSwingLow

//-------------------------
// Change Of Character
//-------------------------

bullCHOCH = bullBOS and bearTrend
bearCHOCH = bearBOS and bullTrend

//-------------------------
// Smart Money Score
//-------------------------

int smcBuyScore = 0
int smcSellScore = 0

if bullBOS
    smcBuyScore += 40

if bullCHOCH
    smcBuyScore += 60

if bearBOS
    smcSellScore += 40

if bearCHOCH
    smcSellScore += 60

//-------------------------
// Final SMC Signal
//-------------------------

bullSMC = smcBuyScore >= 60
bearSMC = smcSellScore >= 60

// Hidden plots
plot(smcBuyScore, title="SMC Buy Score", display=display.none)
plot(smcSellScore, title="SMC Sell Score", display=display.none)

//====================================================
// MODULE 06 - ENTRY ENGINE
//====================================================

//-------------------------
// ENTRY FILTERS
//-------------------------

useTrendFilter = input.bool(true, "Use Trend Filter", group="Entry Engine")
useMomentumFilter = input.bool(true, "Use Momentum Filter", group="Entry Engine")
useSMCFilter = input.bool(true, "Use Smart Money Filter", group="Entry Engine")

//-------------------------
// FILTER RESULTS
//-------------------------

bool trendBuyOK = not useTrendFilter or strongBullTrend
bool trendSellOK = not useTrendFilter or strongBearTrend

bool momentumBuyOK = not useMomentumFilter or bullMomentum
bool momentumSellOK = not useMomentumFilter or bearMomentum

bool smcBuyOK = not useSMCFilter or bullSMC
bool smcSellOK = not useSMCFilter or bearSMC

//-------------------------
// FINAL ENTRY
//-------------------------

bool buyEntry = buySignal and trendBuyOK and momentumBuyOK and smcBuyOK
bool sellEntry = sellSignal and trendSellOK and momentumSellOK and smcSellOK

//-------------------------
// ENTRY LABELS
//-------------------------

plotshape(series=buyEntry, title="BUY", style=shape.labelup, location=location.belowbar, color=color.lime, text="BUY", textcolor=color.white, size=size.small)

plotshape(series=sellEntry, title="SELL", style=shape.labeldown, location=location.abovebar, color=color.orange, text="SELL", textcolor=color.white, size=size.small)

//====================================================
// MODULE 07 - TRADE MANAGER
//====================================================

//-------------------------
// TRADE VARIABLES
//-------------------------

var float tradeEntry = na
var float tradeSL = na

var float tradeTP1 = na
var float tradeTP2 = na
var float tradeTP3 = na
var float tradeTP4 = na
var float tradeTP5 = na
var float tradeTP6 = na
var float tradeTP7 = na
var float tradeTP8 = na

//-------------------------
// BUY TRADE
//-------------------------

if buyEntry

    tradeRunning := true
    tradeSide := 1

    tradeEntry := close
    tradeSL := close - atr * atrMultiplier

    risk = tradeEntry - tradeSL

    tradeTP1 := tradeEntry + risk * 1
    tradeTP2 := tradeEntry + risk * 2
    tradeTP3 := tradeEntry + risk * 3
    tradeTP4 := tradeEntry + risk * 4
    tradeTP5 := tradeEntry + risk * 5
    tradeTP6 := tradeEntry + risk * 6
    tradeTP7 := tradeEntry + risk * 7
    tradeTP8 := tradeEntry + risk * 8

//-------------------------
// SELL TRADE
//-------------------------

if sellEntry

    tradeRunning := true
    tradeSide := -1

    tradeEntry := close
    tradeSL := close + atr * atrMultiplier

    risk = tradeSL - tradeEntry

    tradeTP1 := tradeEntry - risk * 1
    tradeTP2 := tradeEntry - risk * 2
    tradeTP3 := tradeEntry - risk * 3
    tradeTP4 := tradeEntry - risk * 4
    tradeTP5 := tradeEntry - risk * 5
    tradeTP6 := tradeEntry - risk * 6
    tradeTP7 := tradeEntry - risk * 7
    tradeTP8 := tradeEntry - risk * 8

//-------------------------
// COPY VALUES
//-------------------------

entryPrice := tradeEntry
stopLoss := tradeSL

tp1 := tradeTP1
tp2 := tradeTP2
tp3 := tradeTP3
tp4 := tradeTP4
tp5 := tradeTP5
tp6 := tradeTP6
tp7 := tradeTP7
tp8 := tradeTP8
//====================================================
// MODULE 08 - TAKE PROFIT ENGINE
//====================================================

//-------------------------
// TP SETTINGS
//-------------------------

tpATRMultiplier = input.float(1.0, "TP ATR Multiplier", step=0.1, group="Take Profit")

//-------------------------
// BUY TAKE PROFITS
//-------------------------

if buyEntry

    entryPrice := close
    tradeSide := 1
    tradeRunning := true

    stopLoss := entryPrice - atr * atrMultiplier

    tp1 := entryPrice + atr * tpATRMultiplier * 1
    tp2 := entryPrice + atr * tpATRMultiplier * 2
    tp3 := entryPrice + atr * tpATRMultiplier * 3
    tp4 := entryPrice + atr * tpATRMultiplier * 4
    tp5 := entryPrice + atr * tpATRMultiplier * 5
    tp6 := entryPrice + atr * tpATRMultiplier * 6
    tp7 := entryPrice + atr * tpATRMultiplier * 7
    tp8 := entryPrice + atr * tpATRMultiplier * 8

//-------------------------
// SELL TAKE PROFITS
//-------------------------

if sellEntry

    entryPrice := close
    tradeSide := -1
    tradeRunning := true

    stopLoss := entryPrice + atr * atrMultiplier

    tp1 := entryPrice - atr * tpATRMultiplier * 1
    tp2 := entryPrice - atr * tpATRMultiplier * 2
    tp3 := entryPrice - atr * tpATRMultiplier * 3
    tp4 := entryPrice - atr * tpATRMultiplier * 4
    tp5 := entryPrice - atr * tpATRMultiplier * 5
    tp6 := entryPrice - atr * tpATRMultiplier * 6
    tp7 := entryPrice - atr * tpATRMultiplier * 7
    tp8 := entryPrice - atr * tpATRMultiplier * 8
//====================================================
// MODULE 09 - DRAWING ENGINE (PART 1)
//====================================================

//-------------------------
// LINE VARIABLES
//-------------------------

var line entryLine = na
var line slLine = na

var line tp1Line = na
var line tp2Line = na
var line tp3Line = na
var line tp4Line = na
var line tp5Line = na
var line tp6Line = na
var line tp7Line = na
var line tp8Line = na

//-------------------------
// CREATE NEW DRAWINGS
//-------------------------

if buyEntry or sellEntry

    // Delete old lines
    line.delete(entryLine)
    line.delete(slLine)

    line.delete(tp1Line)
    line.delete(tp2Line)
    line.delete(tp3Line)
    line.delete(tp4Line)
    line.delete(tp5Line)
    line.delete(tp6Line)
    line.delete(tp7Line)
    line.delete(tp8Line)

    // Entry
    entryLine := line.new(
         bar_index,
         entryPrice,
         bar_index + 20,
         entryPrice,
         color=color.white,
         width=2)

    // Stop Loss
    slLine := line.new(
         bar_index,
         stopLoss,
         bar_index + 20,
         stopLoss,
         color=color.red,
         width=2)

    // TP1
    tp1Line := line.new(bar_index, tp1, bar_index + 20, tp1, color=color.lime)

    // TP2
    tp2Line := line.new(bar_index, tp2, bar_index + 20, tp2, color=color.lime)

    // TP3
    tp3Line := line.new(bar_index, tp3, bar_index + 20, tp3, color=color.lime)

    // TP4
    tp4Line := line.new(bar_index, tp4, bar_index + 20, tp4, color=color.lime)

    // TP5
    tp5Line := line.new(bar_index, tp5, bar_index + 20, tp5, color=color.lime)

    // TP6
    tp6Line := line.new(bar_index, tp6, bar_index + 20, tp6, color=color.lime)

    // TP7
    tp7Line := line.new(bar_index, tp7, bar_index + 20, tp7, color=color.lime)

    // TP8
    tp8Line := line.new(bar_index, tp8, bar_index + 20, tp8, color=color.lime)
//====================================================
// MODULE 09 - DRAWING ENGINE (PART 2)
//====================================================

//-------------------------
// EXTEND DRAWINGS
//-------------------------

if tradeRunning

    if not na(entryLine)
        line.set_x2(entryLine, bar_index + 20)

    if not na(slLine)
        line.set_x2(slLine, bar_index + 20)

    if not na(tp1Line)
        line.set_x2(tp1Line, bar_index + 20)

    if not na(tp2Line)
        line.set_x2(tp2Line, bar_index + 20)

    if not na(tp3Line)
        line.set_x2(tp3Line, bar_index + 20)

    if not na(tp4Line)
        line.set_x2(tp4Line, bar_index + 20)

    if not na(tp5Line)
        line.set_x2(tp5Line, bar_index + 20)

    if not na(tp6Line)
        line.set_x2(tp6Line, bar_index + 20)

    if not na(tp7Line)
        line.set_x2(tp7Line, bar_index + 20)

    if not na(tp8Line)
        line.set_x2(tp8Line, bar_index + 20)

//====================================================
// MODULE 10 - TRADE ENGINE V2 (PART 1)
//====================================================

//-------------------------
// TRADE STATE
//-------------------------

var bool positionOpen = false
var int positionSide = 0

var float tradeRisk = na
var float tradeReward = na

//-------------------------
// BUY ENTRY
//-------------------------

if buyEntry and not positionOpen

    positionOpen := true
    positionSide := 1

    entryPrice := close
    stopLoss := close - atr * atrMultiplier

    tradeRisk := math.abs(entryPrice - stopLoss)

//-------------------------
// SELL ENTRY
//-------------------------

if sellEntry and not positionOpen

    positionOpen := true
    positionSide := -1

    entryPrice := close
    stopLoss := close + atr * atrMultiplier

    tradeRisk := math.abs(entryPrice - stopLoss)

//-------------------------
// RESET POSITION
//-------------------------

if positionOpen

    if positionSide == 1 and low <= stopLoss
        positionOpen := false
        positionSide := 0

    if positionSide == -1 and high >= stopLoss
        positionOpen := false
        positionSide := 0

